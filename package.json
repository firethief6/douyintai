{
  "name": "douyintai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "demo": "vite --port 1430 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint:ui": "tsc --noEmit",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "cargo test --workspace --all-targets",
    "check": "pnpm lint:ui && pnpm build && pnpm test:ui && pnpm lint:rust && pnpm test",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "node scripts/dev.mjs",
    "test:ui": "node scripts/filter.test.mjs && node scripts/playback-quality.test.mjs && node scripts/stage-nav.test.mjs && node scripts/play-queue.test.mjs",
    "build:app": "node scripts/build-release.mjs",
    "icons:mac": "node scripts/mac-icon.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "1.57.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
